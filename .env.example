# Environment Configuration

# Data paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_TEST_DIR=./data/test_clips

# Model paths
DETECTOR_CHECKPOINT=./models/yolov8n_finetuned.pt
VLM_MODEL_NAME=liuhaotian/llava-v1.5-7b
VLM_CHECKPOINT=./models/llava_quantized.pt

# Inference settings
DETECTOR_CONF_THRESHOLD=0.45
DETECTOR_IOU_THRESHOLD=0.5
VLM_BATCH_SIZE=4

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
MAX_VIDEO_SIZE_MB=500
TEMP_UPLOAD_DIR=./temp/uploads

# GPU/Device settings
DEVICE=cuda  # or 'cpu' for CPU-only inference
DETECTOR_HALF=true  # Use FP16 for detector

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
